{
  "name": "occacio-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs src/run.ts",
    "test-telegram": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs src/run.ts --test-telegram",
    "dry-run": "node node_modules/tsx/dist/cli.mjs src/run.ts --dry-run",
    "test": "node node_modules/tsx/dist/cli.mjs --test test/bot.test.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
